# Copy outside the repository, restrict access to the Registry service account,
# and replace every blank value. Never commit the populated file.

DSH_HOME=/var/lib/dsh-registry/home
REGISTRY_DOMAIN=
DSH_REGISTRY_PUBLIC_ORIGIN=

DSH_REGISTRY_ORGANIZATION_ID=
DSH_REGISTRY_ORGANIZATION_NAME=
DSH_REGISTRY_BOOTSTRAP_MEMBER_ID=
DSH_REGISTRY_BOOTSTRAP_MEMBER_NAME=
DSH_REGISTRY_SYNC_AUDIENCE=
# Non-secret stable identifier for the disclosure root-key version.
DSH_REGISTRY_DISCLOSURE_ROOT_KEY_ID=
DSH_REGISTRY_ALERT_ENDPOINT=
DSH_REGISTRY_OIDC_ISSUER=
DSH_REGISTRY_OIDC_CLIENT_ID=

# Production Registry uses the PostgreSQL SaaS patch and a dedicated
# registry_app runtime role. Keep the SQLite path because the base patch still
# opens its fallback backend, but it is not authoritative and cannot satisfy
# the production preflight.
DSH_REGISTRY_POSTGRES_URL=
DSH_REGISTRY_SQLITE_PATH=/var/lib/dsh-registry/state/registry.sqlite
# Never place DSH_REGISTRY_POSTGRES_MIGRATOR_URL or
# DSH_REGISTRY_POSTGRES_BACKUP_URL or REGISTRY_BACKUP_PASSWORD in the Registry
# service environment.
DSH_REGISTRY_ADMISSION_SQLITE_PATH=/var/lib/dsh-registry/state/admission.sqlite
DSH_REGISTRY_ALERT_OUTBOX_SQLITE_PATH=/var/lib/dsh-registry/state/alert-outbox.sqlite

# Inject these values from the Registry host's production secret manager. They
# are listed only so the scoped preflight can report an omitted variable.
DSH_REGISTRY_ADMISSION_HMAC=
DSH_REGISTRY_ALERT_BEARER_TOKEN=
DSH_REGISTRY_OIDC_CLIENT_SECRET=
DSH_REGISTRY_SESSION_SECRET=
DSH_REGISTRY_MAILBOX_KEY=
# Canonical unpadded base64url encoding of an independent 32-byte root key.
DSH_REGISTRY_DISCLOSURE_ROOT_KEY=
