# Copy outside the repository, restrict access to this Harness service account,
# and replace every blank value. The five DSH_REGISTRY_* / DSH_INSTANCE_ID device
# values can be created with enroll-registry-device.mjs export-env.
# Never copy this device's secrets to Registry.

DSH_HOME=/var/lib/dsh-harness/home
REGISTRY_DOMAIN=
DSH_REGISTRY_ORGANIZATION_ID=
DSH_INSTANCE_ID=
DSH_REGISTRY_SYNC_URL=
DSH_DISCLOSURE_STATE_PATH=/var/lib/dsh-harness/state/disclosures

# Inject these values from this Harness device's production secret manager.
# The token is the confirmed dsh1 credential, never the one-time pairing code.
# Per-disclosure data-key records are provisioned separately by the KMS owner.
DSH_REGISTRY_DEVICE_TOKEN=
DSH_REGISTRY_DEVICE_PRIVATE_KEY=
