# Copy outside the repository, restrict access to this Harness service account,
# and replace every blank value. This public full-publication example requires
# all six DSH_REGISTRY_* / DSH_INSTANCE_ID device values created by a new
# enroll-registry-device.mjs binding plus the model credential below. Legacy
# five-value exports are WSS-only.
# Never copy this device's secrets to Registry.

DSH_HOME=/var/lib/dsh-harness/home
REGISTRY_DOMAIN=
DSH_REGISTRY_ORGANIZATION_ID=
DSH_INSTANCE_ID=
DSH_REGISTRY_SYNC_URL=
# Must be exactly https://REGISTRY_DOMAIN/a2a/v1/disclosure-publication.
DSH_REGISTRY_DISCLOSURE_BRIDGE_URL=
DSH_DISCLOSURE_STATE_PATH=/var/lib/dsh-harness/state/disclosures

# Inject these values from this Harness device's production secret manager.
# The two tokens are independent confirmed dsh1 / dshb1 credentials, never the one-time pairing code.
# DEEPSEEK_API_KEY authorizes the fixed deepseek-official/deepseek-flash route.
# Per-disclosure data-key records are provisioned separately by the KMS owner.
DSH_REGISTRY_DEVICE_TOKEN=
DSH_REGISTRY_DISCLOSURE_TOKEN=
DSH_REGISTRY_DEVICE_PRIVATE_KEY=
DEEPSEEK_API_KEY=
